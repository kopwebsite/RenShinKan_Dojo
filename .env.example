ADMIN_PASSWORD_HASH=PLACEHOLDER_PBKDF2_SHA256_HASH
# JSON object mapping dojo IDs to PBKDF2-SHA-256 password hashes. Keep this a
# server-side Cloudflare Pages secret; never use a VITE_ prefix.
DOJO_ADMIN_PASSWORD_HASHES={"dojo-cmu":"PLACEHOLDER_HASH","dojo-nu":"PLACEHOLDER_HASH"}
SESSION_SECRET=PLACEHOLDER_LONG_RANDOM_SECRET
# Server-side secret only. Configure the production value through Cloudflare Pages.
SITE_URL=https://PLACEHOLDER_DOMAIN.com
ALLOWED_ORIGIN=https://PLACEHOLDER_DOMAIN.com
VITE_SITE_URL=https://PLACEHOLDER_DOMAIN.com
# Local-only development can use Cloudflare's always-pass test site key:
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=PLACEHOLDER_CLOUDFLARE_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=PLACEHOLDER_CLOUDFLARE_TURNSTILE_SECRET_KEY
STUDENT_LOOKUP_PEPPER=PLACEHOLDER_RANDOM_32_BYTE_SECRET
RENSHINKAN_MONTHLY_CONTRIBUTION_AMOUNT=1800
AAT_ANNUAL_CONTRIBUTION_AMOUNT=1200
BREVO_API_KEY=PLACEHOLDER_BREVO_API_KEY
BREVO_LIST_ID=PLACEHOLDER_BREVO_LIST_ID
BREVO_SENDER_EMAIL=PLACEHOLDER_VERIFIED_SENDER_EMAIL
BREVO_SENDER_NAME=RenShinKan Dojo
VITE_BREVO_SIGNUP_FORM_URL=PLACEHOLDER_BREVO_SIGNUP_FORM_URL
