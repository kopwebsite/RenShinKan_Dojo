{
  "name": "renshinkan-dojo",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20 <26"
  },
  "type": "module",
  "scripts": {
    "predev": "npm run optimize:images",
    "dev": "vite",
    "optimize:images": "node scripts/optimize-images.mjs",
    "build": "npm run optimize:images && vite build",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/ranks-and-security.test.ts",
    "test:integration": "vitest run tests/workflow-contracts.test.ts",
    "check": "npm run lint && npm run test && npm run build",
    "auth:hash-password": "node scripts/hash-password.mjs",
    "audit:worker:types": "wrangler types audit-cleanup-env.d.ts --cwd serverless --config ../wrangler.audit-cleanup.jsonc --env-file serverless/.env.types --include-runtime=false",
    "audit:worker:check": "wrangler deploy --dry-run --config wrangler.audit-cleanup.jsonc",
    "deploy": "npm run build && wrangler pages deploy dist --project-name renshinkan-dojo --branch main",
    "preview": "vite preview"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7",
    "wrangler": "^4.110.0"
  },
  "overrides": {
    "sharp": "$sharp"
  }
}
