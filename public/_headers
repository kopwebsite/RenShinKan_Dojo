/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com; frame-src 'self' https:; connect-src 'self' https://challenges.cloudflare.com https://cloudflareinsights.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/build.json
  Cache-Control: no-cache, must-revalidate

/site-bootstrap.js
  Cache-Control: no-cache, must-revalidate

/help/screenshots/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/optimized/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/uploads/generated/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/uploads/admin/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

/*.avif
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

/*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

/*.pdf
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
  ! Content-Security-Policy
  ! X-Frame-Options

/
  Cache-Control: no-cache, must-revalidate

/aikido
  Cache-Control: no-cache, must-revalidate

/classes
  Cache-Control: no-cache, must-revalidate

/community
  Cache-Control: no-cache, must-revalidate

/contact
  Cache-Control: no-cache, must-revalidate

/instructors
  Cache-Control: no-cache, must-revalidate

/newsletter
  Cache-Control: no-cache, must-revalidate

/newsletter/*
  Cache-Control: no-cache, must-revalidate

/downloads
  Cache-Control: no-cache, must-revalidate

/downloads/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
  ! Content-Security-Policy
  ! X-Frame-Options

/support
  Cache-Control: no-cache, must-revalidate

/workshops
  Cache-Control: no-cache, must-revalidate

/api/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow

/admin
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow

/admin/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow

/student-records
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow

/records/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow
